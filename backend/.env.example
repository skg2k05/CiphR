# Database configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ciphr
# If using Supabase directly, you can also set SUPABASE_URL and SUPABASE_KEY
SUPABASE_URL=
SUPABASE_KEY=

# LLM Providers
GROQ_API_KEY=
GEMINI_API_KEY=

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_APK_SIZE_MB=100

# Environment and Logging
ENVIRONMENT=development
LOG_LEVEL=INFO
