# Database configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ciphr
# If using Supabase directly, you can also set SUPABASE_URL and SUPABASE_KEY

# Optional Supabase Database (for production)
SUPABASE_URL=
SUPABASE_KEY=

# LLM Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_APK_SIZE_MB=100

# Environment and Logging
ENVIRONMENT=development
LOG_LEVEL=INFO
